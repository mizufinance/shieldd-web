{
  "name": "@mizufinance/wasm",
  "version": "53.0.1-bankd-demo.1",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "engine": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build --verbose",
    "clean": "rm -rfv dist *.tsbuildinfo wasm package mizufinance-*.tgz",
    "clean:rust": "cargo clean --manifest-path ./crate/Cargo.toml",
    "compile": "cd crate && wasm-pack build --${SHIELDD_BUILD_PROFILE:-release} --no-pack --target web --out-name index --out-dir ../wasm --no-opt",
    "dev:compile": "cargo watch -C ./crate --postpone -- $npm_execpath run compile",
    "dev:pack": "tsc-watch --onSuccess \"$npm_execpath pack\"",
    "format:rust": "cd crate && cargo fmt --all",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:rust": "cd crate && cargo fmt --all -- --check && cargo clippy -- -D warnings && cargo clippy --tests -- -D warnings",
    "lint:strict": "tsc --noEmit && eslint src --max-warnings 0",
    "postcompile": "mkdir -p ./wasm && touch ./wasm/.npmignore",
    "test": "vitest run",
    "test:cargo": "cd crate && cargo test",
    "test:wasm": "cd crate && wasm-pack test --headless --firefox -- --target wasm32-unknown-unknown"
  },
  "files": [
    "wasm",
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@mizufinance/bech32m": "workspace:*",
    "@mizufinance/protobuf": "workspace:*",
    "@mizufinance/types": "workspace:*",
    "@tsconfig/strictest": "2.0.5",
    "fake-indexeddb": "^6.0.0",
    "typescript": "5.5.3"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@mizufinance/bech32m": "workspace:*",
    "@mizufinance/protobuf": "workspace:*",
    "@mizufinance/types": "workspace:*"
  }
}
